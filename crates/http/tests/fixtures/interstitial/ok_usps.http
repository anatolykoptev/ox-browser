<style>

.holiday-center {
    /*background-color: #004B87;*/
    color: #FFFFFF;
    display: flex;
    gap: 24px;
	justify-content: space-around;
}
.holiday-center>div {
    display:flex;
    padding: 40px 15px;
}

.holiday-center>div.callouts {
    flex-wrap: nowrap;
    flex-direction: column;
}
.holiday-center>div.dates {

}

.holiday-center p {
    color: #FFFFFF;
    font-size: 18px;
    line-height:24px;
    font-weight:bold;
}
.holiday-button {
    padding: 10px 20px;
    color: #FFFFFF !important;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
    border: 1px solid #FFFFFF;
    border-radius: 8px;
    margin: 10px 0;
    display: inline-block;
    text-align: center;
    text-decoration: none !important;
}
.dates > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-content: stretch;
    flex-wrap: wrap;
    font-size: 14px;
    max-width: 250px;
    border-left: 1px solid #FFFFFF;
}
    .dates>div > span {
        padding: 0 20px;
        max-width: 300px;
    }
.dates>div > span:nth-of-type(1), .dates>div > span:nth-of-type(3) {
    font-size: 14px;
    line-height: 18px;
    text-align:center;
}
.dates>div > span:nth-of-type(2){
    font-size: 32px;
            font-weight: bold;

}
.dates > div:first-of-type {
    border-left: 0;
}

a.holiday-button:hover,a.holiday-button:focus {
    color: #004B87!important;
    background: #FFFFFF;
}
.holiday-mailing h2, .holiday-mailing p {
    color: #ffffff;
}
p.holiday-disclaimer {
    max-width: 700px;
    padding-top: 30px;
}
.holiday-center-blurb {
    background: #004B87;
    padding: 30px 0 60px 0;
}
.holiday-container {
    background: url(/holiday/images-26/hc_background.jpg);
    padding: 0px 0 60px 0;
    background-color: #004B87;
    background-position: top center;
    background-repeat: no-repeat;
    background-size: 1265px auto;
}
.holiday-mailing .holiday-button {
	background: #ffffff;
	color: #004B87!important;
	border: 1px solid #004b87;
}
.holiday-mailing .holiday-button:hover,.holiday-mailing .holiday-button:focus {
	color: #ffffff!important;
	background: #004B87;
	border: 1px solid #ffffff;
}
.holiday-center {
    position:relative;
}
.holiday-center .callouts,.holiday-center .dates {
    z-index:99;
}


.holiday-center:before {
    content: '';
    background: #004B87;
    width:120%;
    height: 100%;
    top:0;
    left:-10%;
    position:absolute;
    opacity:.5;
}


.holiday-mailing {
    padding-top: 60px;
}
@media (max-width: 800px){
.holiday-center {
    flex-wrap: wrap;
    gap: 00;
}
.holiday-center>div.dates {
    padding-top: 0;
}
.holiday-center:before {
    content: '';
    background: #004B87;
    width:120%;
    height: 100%;
    top:0;
    z-index:10;
    left:-10%;
    position:absolute;
    opacity: 1;
}
.holiday-container {
    background-position: bottom center;
}
}
@media (max-width: 600px){
        .holiday-center {
        flex-wrap: nowrap;
        gap: 00;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
.holiday-center>div.dates {
    flex-wrap: wrap;
    flex-direction: column;
    gap: 24px;
    justify-self: end;
    display: flex;
    align-content: stretch;
    justify-content: space-evenly;
}
    .dates > div {
        border: 0;
    }
}
}
</style>
