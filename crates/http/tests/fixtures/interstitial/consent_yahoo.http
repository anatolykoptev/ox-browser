    <style nonce="REDACTED">/* Static brand header that replaces ybar-api-service (PRI-918). These are the rules ybar 3.10.114
   applied to the logo, renamed from its hashed classes. Selectors keep ybar's specificity (classes
   only, no ids), so the page stylesheets' "#ybar div" overrides keep winning as they did before. */
#ybar{display:block;box-sizing:border-box;text-align:start;z-index:1000;-webkit-font-smoothing:antialiased}
#ybar-inner-wrap{display:flex;flex-direction:column}
.ybar-row{display:flex;justify-content:center}
.ybar-bar{display:flex;justify-content:flex-start;align-items:center;width:100%;min-width:0;max-width:1920px;box-sizing:border-box;height:84px;padding:0}
.ybar-property-guce .ybar-bar{padding-inline-start:50px;padding-inline-end:64px;background:#6302de}
.ybar-property-gdpr .ybar-bar{padding-inline-start:54px;padding-inline-end:64px}
/* ybar's gdpr header ended with an empty account-menu slot that took the free space, which kept the logo at
   the start; build and ryot had no such slot */
.ybar-property-gdpr .ybar-bar::after{content:"";flex:none;width:32px;margin-inline-start:auto}
.ybar-property-gdpr.ybar-variant-build .ybar-bar::after,
.ybar-property-gdpr.ybar-variant-ryot .ybar-bar::after{content:none}
.ybar-property-guce.ybar-variant-aol .ybar-bar,
.ybar-property-guce.ybar-variant-makers .ybar-bar,
.ybar-property-guce.ybar-variant-polyvore .ybar-bar{background:#000}
.ybar-property-guce.ybar-variant-autoblog .ybar-bar{background:#2b2c2f}
.ybar-property-guce.ybar-variant-build .ybar-bar{background:#333}
.ybar-property-guce.ybar-variant-engadget .ybar-bar{background:#2b2d32}
.ybar-property-guce.ybar-variant-intheknow .ybar-bar{background:0 0}
.ybar-property-guce.ybar-variant-ryot .ybar-bar{background:#0a0a0a}
.ybar-property-guce.ybar-variant-talktalk .ybar-bar{background:#1e4e9d}
.ybar-logo-box{display:flex;width:142px;min-width:142px}
.ybar-logo-link{display:flex;align-items:stretch;font-size:0;height:100%}
.ybar-logo-link:focus{outline-offset:2px}
.ybar-logo-img{align-self:flex-start;max-height:100%;max-width:100%}
.ybar-logo-light{display:block}
.ybar-logo-dark{display:none}
/* The theme class comes from the header root (guce) or, on edit consent, from the page's
   <div class="ybar-{{ybarGdprTheme}}"> wrapper, which is why the gdpr header root carries no theme class. */
.ybar-dark .ybar-logo-light{display:none}
.ybar-dark .ybar-logo-dark{display:block}
.ybar-light .ybar-logo-dark{display:none}
#ybar :focus{outline:solid #0f69ff 2px}
#ybar :focus:not(:focus-visible){outline:0}
@media screen and (min-width:768px){.ybar-logo-img{max-height:40px}}
@media screen and (max-width:768px){
.ybar-property-guce .ybar-bar{height:50px;padding:0;justify-content:center;position:relative}
.ybar-property-gdpr .ybar-bar{height:54px;padding-inline-start:20px;padding-inline-end:24px;justify-content:center;position:relative}
.ybar-property-gdpr .ybar-bar::after{width:24px}
.ybar-logo-box{width:auto;min-width:auto}
.ybar-logo-link .ybar-logo-img{height:100%;max-height:32px}
.ybar-variant-aol .ybar-logo-box{height:18px}
.ybar-variant-engadget .ybar-logo-box{height:24px}
.ybar-variant-intheknow .ybar-logo-box{height:25px;width:64px}
.ybar-property-guce.ybar-variant-talktalk .ybar-logo-box{height:20px}
}
</style>
    <style nonce="REDACTED">#consent-page #ybar div{background: #fff;padding-left: 0}.btn {padding: 15px;font-size:20px;min-width: 30%;}.btn.primary{background-color: #0f69ff;color: #fff;cursor: pointer;}#consent-text a:not(.btn){text-decoration:underline;}</style>
</head>
