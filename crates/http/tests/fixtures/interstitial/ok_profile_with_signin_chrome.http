=2147483647&v=beta&t=-stCWN6KYl9Q8zJBTUWI4PgDhzSor3Du4-9D7_DvaCE"},"interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":4023},"url":"https://example.test/pulse/bad-news-isnt-only-bill-gates-tl0bc"},{"@type":"Article","author":{"@type":"Person","name":"Bill Gates","url":"https://example.test/in/williamhgates"},"dateModified":"","datePublished":"2026-07-30T15:36:01.000+00:00","headline":"The best things I read, listened to, and watched this year","image":{"@type":"ImageObject","url":"https://media.licdn.com/dms/image/v2/D4E12AQFuGC-ILTwDIA/article-cover_image-shrink_720_1280/B4EZ.0ivrdIkAQ-/0/1785440435195?e=2147483647&v=beta&t=UzAPg6FRRAENPa4zUS5ULz6NRHbEuMDwEIkmd_nrWeM"},"interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":3305},"url":"https://example.test/pulse/best-things-i-read-listened-watched-year-bill-gates-saopc"},{"@type":"Article","author":{"@type":"Person","name":"Bill Gates","url":"https://example.test/in/williamhgates"},"dateModified":"","datePublished":"2026-07-26T16:59:42.000+00:00","headline":"Memories from an inspiring trip to Rwanda","image":{"@type":"ImageObject","url":"https://media.licdn.com/dms/image/v2/D4E12AQHSV3ES4S-Cuw/article-cover_image-shrink_720_1280/B4EZ.fRL7dJ0AQ-/0/1785083510790?e=2147483647&v=beta&t=v-g_uv0TSKbSQzYu5Is8w15ZuODA_KjsEenQqgn7v8M"},"interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":4912},"url":"https://example.test/pulse/memories-from-inspiring-trip-rwanda-bill-gates-ojyye"},{"@type":"Article","author":{"@type":"Person","name":"Bill Gates","url":"https://example.test/in/williamhgates"},"dateModified":"","datePublished":"2026-07-12T17:14:33.000+00:00","headline":"\"AIDS-free\" generation is no empty promise","image":{"@type":"ImageObject","url":"https://media.licdn.com/dms/image/v2/D4E12AQE9z5HnHXNBsQ/article-cover_image-shrink_720_1280/B4EZ9XOTLKJEAQ-/0/1783874794451?e=2147483647&v=beta&t=MRRY8W-94LfA6nZvCNs5pIUE6bDQMdQB7LDu3_Tre0s"},"interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":3453},"url":"https://example.test/pulse/aids-free-generation-empty-promise-bill-gates-hbvue"},{"@context":"https://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Person","name":"Bill Gates","url":"https://example.test/in/williamhgates"},"datePublished":"2026-11-14T18:11:59.973Z","headline":"","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":557},"mainEntityOfPage":"https://example.test/posts/williamhgates_after-20-years-of-working-abroad-dr-segenet-activity-7527433167067193345-3q92","text":"After 20 years of working abroad, Dr. Segenet Kelemu returned to her home country of Ethiopia to help strengthen agriculture research across the continent. Today, she and her team are turning Africa’s enormous potential into practical agricultural solutions.","url":"https://example.test/posts/williamhgates_after-20-years-of-working-abroad-dr-segenet-activity-7527433167067193345-3q92"},{"@context":"https://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Person","name":"Bill Gates","url":"https://example.test/in/williamhgates"},"datePublished":"2026-11-12T01:29:29.562Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":889},"mainEntityOfPage":"https://example.test/posts/williamhgates_when-your-familys-food-and-livelihood-depend-activity-7526456102226403328-ORoD","text":"When your family’s food and livelihood depend on the right timing, a reliable weather forecast is invaluable. That’s why work like TomorrowNow’s matters: https://lnkd.in/ejii8AqU","url":"https://example.test/posts/williamhgates_when-your-familys-food-and-livelihood-depend-activity-7526456102226403328-ORoD"},{"@context":"https://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Person","name":"Bill Gates","url":"https://example.test/in/williamhgates"},"datePublished":"2026-11-10T21:53:56.712Z","headline":"","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":2440},"mainEntityOfPage":"https://example.test/posts/williamhgates_agriculture-is-where-i-see-ai-making-the-activity-7526039470060613632-4h_6","text":"Agriculture is where I see AI making the fastest impact in low-income countries. TomorrowNow is helping fuel that momentum with AI-powered weather forecasts that turn complex and sometimes unreliable data into easy-to-follow planting guidance, sent by text in local languages. For smallholder farmers whose food and livelihoods depend on getting the timing just right, this guidance is invaluable.","url":"https://example.test/posts/williamhgates_agriculture-is-where-i-see-ai-making-the-activity-7526039470060613632-4h_6"},{"@context":"https://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Person","name":"Bill Gates","url":"https://example.test/in/williamhgates"},"datePublished":"2026-11-10T16:12:27.290Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":320},"mainEntityOfPage":"https://example.test/posts/williamhgates_a-new-kind-of-battery-is-taking-off-this-activity-7525953531191672832-a9WJ","text":"One of the most promising things about thermal batteries is their potential to make clean industrial heat more affordable and reliable. It’s exciting to see Rondo Energy and Antora Energy taking different approaches to that challenge.","url":"https://example.test/posts/williamhgates_a-new-kind-of-battery-is-taking-off-this-activity-7525953531191672832-a9WJ"},{"@context":"https://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Person","name":"Bill Gates","url":"https://example.test/in/williamhgates"},"datePublished":"2026-11-06T20:51:44.975Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":1491},"mainEntityOfPage":"https://example.test/posts/williamhgates_bad-news-isnt-the-only-news-bill-gates-activity-7524574266554605568-I338","text":"The challenges we face today are tough. But I try to remember that we've cut child deaths by more than half since the turn of the century, that 1.5 billion fewer people live in extreme poverty today than in 1990, and that, for the first time ever, we have a blood test for Alzheimer's and drugs that may slow its progression.\n\nThat progress is remarkable. And it's proof that we can solve tough challenges again: https://lnkd.in/evkxp6Je","url":"https://example.test/posts/williamhgates_bad-news-isnt-the-only-news-bill-gates-activity-7524574266554605568-I338"},{"@context":"https://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Person","name":"Bill Gates","url":"https://example.test/in/williamhgates"},"datePublished":"2026-11-06T02:11:22.278Z","headline":"","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":2880},"mainEntityOfPage":"https://example.test/posts/williamhgates_andrew-travels-far-and-wide-to-sit-with-families-activity-7524292314127810561-j6rb","text":"Andrew travels far and wide to sit with families, hear their stories of loss, and document deaths that would otherwise go unreported. What he learns helps save lives.​","url":"https://example.test/posts/williamhgates_andrew-travels-far-and-wide-to-sit-with-families-activity-7524292314127810561-j6rb"},{"@type":"WebPage","reviewedBy":{"@type":"Person","name":"Bill Gates"},"url":"https://example.test/in/williamhgates"},{"@context":"http://schema.org","@type":"Person","address":{"@type":"PostalAddress","addressCountry":"US","addressLocality":"Seattle, Washington, United States"},"alumniOf":[{"@type":"EducationalOrganization","name":"Harvard University","url":"https://example.test/school/harvard-university/","member":{"@type":"OrganizationRole","startDate":1973,"endDate":1975}}],"awards":[],"disambiguatingDescription":"Creator, Top Voice","image":{"@type":"ImageObject","contentUrl":"https://media.licdn.com/dms/image/v2/D5603AQF-RYZP55jmXA/profile-displayphoto-shrink_200_200/B56ZRi8g.aGsAY-/0/1736826818802?e=2147483647&v=beta&t=bKWfN6UwwtiCqFWsG7rBELbd48qJOAMLdxhBzzkJV0k"},"jobTitle":["Co-chair","Founder","Co-founder"],"knowsLanguage":[],"memberOf":[],"name":"Bill Gates","sameAs":"https://example.test/in/williamhgates","url":"https://example.test/in/williamhgates","worksFor":[{"@type":"Organization","name":"Gates Foundation","url":"https://example.test/company/gates-foundation","member":{"@type":"OrganizationRole","startDate":2000}},{"@type":"Organization","name":"Breakthrough Energy ","url":"https://example.test/company/breakthrough-energy","member":{"@type":"OrganizationRole","startDate":2015}},{"@type":"Organization","name":"Microsoft","url":"https://example.test/company/microsoft","member":{"@type":"OrganizationRole","startDate":1975}}],"interactionStatistic":{"@type":"InteractionCounter","interactionType":"https://schema.org/FollowAction","name":"Follows","userInteractionCount":40816347},"description":"Chair of the Gates Foundation. Founder of Breakthrough Energy. Co-founder of Microsoft. Voracious reader. Avid traveler. Active blogger."}]}
    </script>
  
        
