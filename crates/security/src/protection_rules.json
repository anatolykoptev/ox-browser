  "rules": [
    {
      "name": "Cloudflare Bot Management",
      "category": "bot_detection",
      "signals": {
        "cookies": ["cf_clearance", "__cf_bm"],
        "headers": {
          "cf-mitigated": "challenge"
        },
        "scripts": ["challenges\\.cloudflare\\.com"],
        "html_patterns": ["window\\._cf_chl_opt", "__cf_chl_f_tk", "Just a moment\\.\\.\\.</title>"]
      },
      "severity": {
        "public": "info",
        "login": "info",
        "authenticated": "info"
      },
      "confidence_boost": {
        "cookies": 70,
        "headers": 80,
        "scripts": 70,
        "html_patterns": 60
      }
    },
