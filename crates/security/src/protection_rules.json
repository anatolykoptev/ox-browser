  "mode_findings": {
    "login": {
      "no_captcha": {
        "severity": "medium",
        "message": "Login page has no CAPTCHA protection — vulnerable to credential stuffing"
      },
      "no_bot_detection": {
        "severity": "low",
        "message": "Login page has no bot detection (WAF/anti-bot) — automated attacks not mitigated"
      },
      "no_fingerprinting": {
        "severity": "info",
        "message": "Login page has no device fingerprinting — no device-based fraud detection"
      },
      "no_rate_limiting_hint": {
        "severity": "low",
        "message": "No rate-limiting headers detected (X-RateLimit-*) — brute force not visibly mitigated"
      }
    },
    "authenticated": {
      "session_no_secure": {
        "severity": "high",
        "message": "Session cookie missing Secure flag on authenticated page"
      },
      "session_no_httponly": {
        "severity": "high",
        "message": "Session cookie missing HttpOnly flag — XSS can steal session"
      },
      "no_csrf_protection": {
        "severity": "high",
        "message": "Authenticated page with forms but no CSRF protection"
      }
    }
  }
